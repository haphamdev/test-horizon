# Shared Laravel runtime config for every regional app/horizon container.
# These OVERRIDE the bind-mounted .env (Docker env wins over Laravel's immutable
# dotenv), so only APP_KEY and other non-regional base values come from .env.
#
# The regional Horizon dashboard app (separate, ./horizon-dashboard) MUST reuse
# these to read the same backend data:
#   REDIS_PREFIX, HORIZON_PREFIX, REDIS_PASSWORD  (+ the region's REDIS_HOST).
APP_ENV=local

DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=mysecretpassword

REDIS_CLIENT=phpredis
REDIS_PORT=6379
REDIS_PASSWORD=mypassword
REDIS_PREFIX=notifyhub:

QUEUE_CONNECTION=redis
HORIZON_PREFIX=notifyhub_horizon:
